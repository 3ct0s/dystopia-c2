# Copy to /etc/dystopia/discord.env (chmod 600). Never commit the real file.
DISCORD_BOT_TOKEN=replace_me
DISCORD_GUILD_ID=replace_me
DISCORD_CHANNEL_ID=replace_me
DISCORD_WEBHOOK=replace_me
DISCORD_OPERATOR_IDS=replace_me
AGENT_NAME=lab-agent
PACK=script
EVASION=false
# Encrypt Discord secrets inside the packaged agent (default true).
OBFUSCATE=true
# Optional: windows|linux (batch default linux)
TARGET=linux
